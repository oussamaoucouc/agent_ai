# Git files
.git/
.gitignore

# Python cache
__pycache__/
*.py[cod]
*.pyc
.pytest_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Runtime cache (regenerated by application)
cache/
*.cache
*.pkl

# TTS cache (runtime generated)
tts_cache/

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
tmp/

# Documentation
README.md
*.md

# Tests
tests/
test_*.py
*_test.py

# Data (uploaded at runtime)
data/pdfs/
data/docx/
data/text/
data/csv/

# Config state (user-specific, runtime generated)
config/config_state.json
